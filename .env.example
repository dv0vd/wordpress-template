BASE_URL=example.com
# OLD_BASE_URL=old-example.com
APP_NAME=wordpress

FAIL2BAN_IGNORE_IPS='127.0.0.1 <IP_1> <IP_2>'

SSH_PORT=22
SSH_PUBLIC_KEY="ssh-rsa AAAA... user@example"

DB_HOST=db
DB_HOST_PORT=3306
DB_NAME=name
DB_USER=user
DB_PASSWORD=password
DB_ROOT_PASSWORD=root-password
DB_MEMORY=512M
DB_CPUS=1

EA_ENABLE=false
EA_URL=easyappointments
EA_HOST_PORT=8090
EA_MEMORY=128M
EA_CPUS=1
EA_DB_HOST_PORT=3307
EA_DB_NAME=easyappointments
EA_DB_USER=easyappointments
EA_DB_PASSWORD=password
EA_DB_ROOT_PASSWORD=root-password
EA_DB_MEMORY=128M
EA_DB_CPUS=1

BACKUP_ENABLED=true
RCLONE_HOST=1.1.1.1
RCLONE_PORT=22
RCLONE_USERNAME=user
RCLONE_ENCRYPTED_PASSWORD=password
RCLONE_ENCRYPTED_SALT=passwordsalt

SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_PORT=465
SMTP_CRYPTO=ssl
SMTP_FROM_ADDRESS=example.com
SMTP_FROM_NAME=name

WORDPRESS_MEMORY=256M
WORDPRESS_CPUS=1

NGINX_BASIC_AUTH_USERNAME=username
NGINX_BASIC_AUTH_PASSWORD=password
NGINX_LOCAL_PORT=8443
NGINX_MEMORY=128M
NGINX_CPUS=1

PODMAN_MEMORY_LIMIT=1G
PODMAN_CPUS=100%
